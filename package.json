{
  "name": "pi-tmux",
  "version": "0.1.0",
  "description": "Pi extension for safe, controlled management of tmux sessions, windows, and panes",
  "keywords": [
    "pi-package",
    "tmux",
    "terminal"
  ],
  "license": "MIT",
  "type": "module",
  "main": "extensions/index.ts",
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.10.2",
    "typebox": "^1.3.27",
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
